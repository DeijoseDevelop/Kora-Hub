{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kora Hub",
  "version": "1.0.0",
  "identifier": "dev.kora.hub",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kora Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Productivity",
        "shortDescription": "Docs y tareas en un solo lugar, 100% local.",
        "longDescription": "Kora Hub: workspace self-hosted de gestión documental y de proyectos. Los archivos son la verdad; todo lo demás son lentes sobre los mismos datos.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "binaries/kora-hub"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper"
            },
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}
